#!/bin/bash
# Pulls systemd-sysext images from an OCI registry (e.g. Harbor) by digest and activates them.
#
# /etc/ionos-cloud/sysext.d/<name>.conf:
#   REF=<registry>/<repository>@sha256:<manifest digest>
# /etc/ionos-cloud/registry-auth (optional, mode 0600):  <user>:<password>
#
# Ignition's HTTP fetcher cannot follow the registry bearer-token challenge, hence this helper.
set -euo pipefail

conf_dir=${SYSEXT_FETCH_CONF_DIR:-/etc/ionos-cloud/sysext.d}
auth_file=${SYSEXT_FETCH_AUTH_FILE:-/etc/ionos-cloud/registry-auth}
ext_dir=${SYSEXT_FETCH_EXT_DIR:-/opt/extensions}
link_dir=${SYSEXT_FETCH_LINK_DIR:-/etc/extensions}
scheme=${SYSEXT_FETCH_SCHEME:-https}

# A stalled transfer (< 1 KiB/s for 60 s) is aborted and retried instead of blocking kubeadm forever.
curl_opts=(-fsSL --retry "${SYSEXT_FETCH_RETRIES:-10}" --retry-delay 5 --retry-all-errors --connect-timeout 10
           --speed-limit 1024 --speed-time 60)
# Token and manifest responses are tiny; bound them by wall time as well.
small_opts=(--max-time 60)

tmp_root=$(mktemp -d)
trap 'rm -rf "${tmp_root}"' EXIT

log() { echo "sysext-fetch: $*" >&2; }

# token REGISTRY REPOSITORY: prints a bearer token, or nothing if the registry needs none. Fails if
# the registry cannot be reached or a required token cannot be obtained.
token() {
  local registry=$1 repo=$2 headers hdr realm service body tok
  local -a auth=()
  # No --fail: the expected answer is a 401 with the challenge. Retries cover network errors and 5xx.
  headers=$(curl -sS -o /dev/null -D - --connect-timeout 10 "${small_opts[@]}" \
              --retry "${SYSEXT_FETCH_RETRIES:-10}" --retry-delay 5 --retry-connrefused \
              "${scheme}://${registry}/v2/") || { log "cannot reach ${scheme}://${registry}/v2/"; return 1; }
  hdr=$(tr -d '\r' <<< "${headers}" | sed -n 's/^[Ww][Ww][Ww]-[Aa]uthenticate: *[Bb]earer *//p')
  [ -n "${hdr}" ] || return 0
  realm=$(sed -n 's/.*realm="\([^"]*\)".*/\1/p' <<< "${hdr}")
  service=$(sed -n 's/.*service="\([^"]*\)".*/\1/p' <<< "${hdr}")
  [ -s "${auth_file}" ] && auth=(-u "$(cat "${auth_file}")")
  body=$(curl "${curl_opts[@]}" "${small_opts[@]}" ${auth[@]+"${auth[@]}"} -G "${realm}" \
           --data-urlencode "service=${service}" --data-urlencode "scope=repository:${repo}:pull") \
    || { log "token request to ${realm} failed"; return 1; }
  tok=$(jq -r '.token // .access_token // empty' <<< "${body}")
  [ -n "${tok}" ] || { log "no token in the response from ${realm}"; return 1; }
  echo "${tok}"
}

# sha256_of FILE
sha256_of() { sha256sum "$1" | cut -d' ' -f1; }

fetch_one() {
  local name=$1 ref=$2 registry rest repo digest tok tmp manifest layer title dest
  local -a hdrs=()
  registry=${ref%%/*}
  rest=${ref#*/}
  repo=${rest%@*}
  digest=${rest#*@}
  [[ "${digest}" =~ ^sha256:[0-9a-f]{64}$ ]] || { log "${name}: REF must be pinned by sha256 digest: ${ref}"; return 1; }

  tok=$(token "${registry}" "${repo}") || return 1
  [ -n "${tok}" ] && hdrs=(-H "Authorization: Bearer ${tok}")

  tmp=$(mktemp -d "${tmp_root}/${name}.XXXXXX")

  curl "${curl_opts[@]}" "${small_opts[@]}" ${hdrs[@]+"${hdrs[@]}"} \
    -H 'Accept: application/vnd.oci.image.manifest.v1+json' \
    -o "${tmp}/manifest" "${scheme}://${registry}/v2/${repo}/manifests/${digest}"
  [ "sha256:$(sha256_of "${tmp}/manifest")" = "${digest}" ] || { log "${name}: manifest digest mismatch"; return 1; }

  manifest=$(cat "${tmp}/manifest")
  layer=$(jq -r '[.layers[] | select((.annotations["org.opencontainers.image.title"] // "") | endswith(".raw"))][0].digest // empty' <<< "${manifest}")
  title=$(jq -r '[.layers[] | select((.annotations["org.opencontainers.image.title"] // "") | endswith(".raw"))][0].annotations["org.opencontainers.image.title"] // empty' <<< "${manifest}")
  [ -n "${layer}" ] && [ -n "${title}" ] || { log "${name}: no *.raw layer in ${ref}"; return 1; }
  [[ "${title}" =~ ^[A-Za-z0-9._+-]+\.raw$ ]] || { log "${name}: refusing layer title ${title}"; return 1; }

  dest="${ext_dir}/${name}/${title}"
  if [ -f "${dest}" ] && [ "sha256:$(sha256_of "${dest}")" = "${layer}" ]; then
    log "${name}: ${title} already present"
  else
    curl "${curl_opts[@]}" ${hdrs[@]+"${hdrs[@]}"} -o "${tmp}/blob" "${scheme}://${registry}/v2/${repo}/blobs/${layer}"
    [ "sha256:$(sha256_of "${tmp}/blob")" = "${layer}" ] || { log "${name}: blob digest mismatch"; return 1; }
    mkdir -p "${ext_dir}/${name}"
    install -m 0644 "${tmp}/blob" "${dest}"
    log "${name}: installed ${title} (${layer})"
  fi
  mkdir -p "${link_dir}"
  ln -sfn "${dest}" "${link_dir}/${name}.raw"
}

shopt -s nullglob
confs=("${conf_dir}"/*.conf)
[ "${#confs[@]}" -gt 0 ] || { log "nothing to fetch"; exit 0; }

for conf in "${confs[@]}"; do
  name=$(basename "${conf}" .conf)
  ref=$(sed -n 's/^REF=//p' "${conf}" | head -n1)
  [ -n "${ref}" ] || { log "${conf}: missing REF="; exit 1; }
  fetch_one "${name}" "${ref}"
done

if [ "${SYSEXT_FETCH_NO_REFRESH:-0}" != 1 ]; then
  systemd-sysext refresh
fi
